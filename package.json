{
  "name": "cross-system-automation-bridge",
  "version": "2.0.0",
  "description": "Scheduled automation service that detects preventive maintenance events and creates deduplicated tickets",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/db/seed.js",
    "run-bridge-once": "node src/jobs/runOnce.js",
    "docker:build": "docker build -t cross-system-bridge .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "test": "node src/tests/testRunner.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "better-sqlite3": "^11.3.0",
    "node-cron": "^3.0.3",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}